# 复制需要的变量到当前终端环境；应用不会自动读取 .env 文件。
# OpenAI：只设置密钥即可使用默认地址。
RAG_API_KEY=
RAG_BASE_URL=https://api.openai.com/v1
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_CHAT_MODEL=gpt-5-mini
RAG_CHAT_API=responses

# 无密钥的 OpenAI 兼容服务（例如本地服务）可设为 1。
# RAG_REMOTE=1
# RAG_BASE_URL=http://127.0.0.1:11434/v1
# RAG_CHAT_MODEL=qwen3:8b
# RAG_CHAT_API=chat_completions
# RAG_EMBEDDING_MODEL=nomic-embed-text

# 服务与切分参数
RAG_HOST=127.0.0.1
RAG_PORT=8000
RAG_MAX_UPLOAD_MB=20
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150

# 互联网自动采集
BRAVE_SEARCH_API_KEY=
CRAWLER_USER_AGENT=ZhiyuRAGBot/1.0 (private research crawler; respects robots.txt)
CRAWLER_MAX_PAGES=200
CRAWLER_REQUEST_TIMEOUT=20
CRAWLER_HOST_DELAY=3
